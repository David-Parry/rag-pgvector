# =============================================================================
# rag-pgvector environment variables
# Copy to .env and fill in values. Never commit .env.
# =============================================================================

# -----------------------------------------------------------------------------
# AWS Bedrock (Titan v2 embeddings)
# Recommended: use a Bedrock API key (a single bearer token).
# Generate at: AWS console -> Amazon Bedrock -> API keys -> Generate long-term key
# Make sure amazon.titan-embed-text-v2:0 is enabled under Bedrock -> Model access.
# -----------------------------------------------------------------------------
AWS_BEARER_TOKEN_BEDROCK=replace-with-bedrock-api-key
AWS_REGION=us-east-1
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
BEDROCK_EMBEDDING_DIMENSIONS=1024

# Optional fallback if you prefer long-lived IAM access keys instead of a Bedrock API key.
# Leave blank when AWS_BEARER_TOKEN_BEDROCK is set.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# -----------------------------------------------------------------------------
# Anthropic (default LLM)
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=replace-with-anthropic-api-key
ANTHROPIC_MODEL=claude-sonnet-4-5

# -----------------------------------------------------------------------------
# Ollama (alternative LLM, runs on the Docker Desktop host)
# Inside a pod, host.docker.internal resolves to the laptop running Docker Desktop.
# -----------------------------------------------------------------------------
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1:8b

# -----------------------------------------------------------------------------
# LLM provider selector for question-api: "anthropic" (default) | "ollama"
# -----------------------------------------------------------------------------
LLM_PROVIDER=anthropic

# -----------------------------------------------------------------------------
# GovInfo (https://api.govinfo.gov)
# Free key from https://api.data.gov/signup/
# -----------------------------------------------------------------------------
GOVINFO_API_KEY=replace-with-govinfo-api-key
GOVINFO_BASE_URL=https://api.govinfo.gov

# -----------------------------------------------------------------------------
# Postgres + pgvector (in-cluster: postgres.rag.svc.cluster.local; local: localhost)
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://rag:rag@localhost:5432/rag
PGVECTOR_COLLECTION=rag_chunks

# -----------------------------------------------------------------------------
# Retrieval tuning
# -----------------------------------------------------------------------------
RETRIEVAL_TOP_K=5
RETRIEVAL_SCORE_THRESHOLD=0.25

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_LEVEL=DEBUG
LOG_FORMAT=json
