# =============================================================================
# rag-pgvector environment variables
# Copy to .env and fill in values. Never commit .env.
# =============================================================================

# -----------------------------------------------------------------------------
# Direct Anthropic Claude API (default LLM)
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY_FILE=claudeapi.txt
# ANTHROPIC_API_KEY=replace-with-direct-anthropic-api-key
ANTHROPIC_DIRECT_MODEL=claude-sonnet-4-5
ANTHROPIC_TIMEOUT_SECONDS=90

# -----------------------------------------------------------------------------
# AWS Bedrock embeddings (old direct credential path, not the ACA Claude role)
# Use a model enabled in the embedding account. This is intentionally separate
# from Anthropic answer generation because Anthropic does not provide embeddings.
# -----------------------------------------------------------------------------
AWS_REGION=us-east-1
AWS_BEARER_TOKEN_BEDROCK=replace-with-embedding-account-bedrock-api-key
EMBEDDING_MODEL=amazon.titan-embed-text-v2:0
BEDROCK_EMBEDDING_DIMENSIONS=1024

# Optional local AWS credentials for embedding access.
# AWS_PROFILE=replace-with-local-profile-name
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
#
# Set this only for internal/on-prem deployments that intentionally do not inject
# Bedrock embedding credentials. Off the internal network, helm-install requires
# one of the credential options above so /ask can embed questions.
# RAG_INTERNAL_NETWORK=1

# -----------------------------------------------------------------------------
# AWS Bedrock Nova Sonic (realtime voice) — prefer scoped STS credentials.
# Generate with:
#   aws sts assume-role \
#     --role-arn <SONIC_AWS_ROLE_ARN> \
#     --role-session-name nova-sonic-12h-$(date +%Y%m%d) \
#     --duration-seconds 43200
# AWS caps assume-role at the role's MaxSessionDuration (12h hard max).
# -----------------------------------------------------------------------------
BEDROCK_NOVA_SONIC_MODEL_ID=amazon.nova-sonic-v1:0
SONIC_AWS_ROLE_ARN=
SONIC_AWS_ACCESS_KEY_ID=
SONIC_AWS_SECRET_ACCESS_KEY=
SONIC_AWS_SESSION_TOKEN=
SONIC_AWS_CREDENTIAL_EXPIRATION=

VOICE_ENABLED=true
NOVA_SONIC_VOICE=matthew
NOVA_SONIC_ENDPOINTING_SENSITIVITY=MEDIUM

# -----------------------------------------------------------------------------
# GovInfo (https://api.govinfo.gov)
# Free key from https://api.data.gov/signup/
# -----------------------------------------------------------------------------
GOVINFO_API_KEY=replace-with-govinfo-api-key
GOVINFO_BASE_URL=https://api.govinfo.gov

# -----------------------------------------------------------------------------
# Postgres + pgvector (in-cluster: postgres.rag.svc.cluster.local; local: localhost)
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://rag:rag@localhost:5432/rag
PGVECTOR_COLLECTION=rag_chunks

# -----------------------------------------------------------------------------
# Retrieval tuning
# -----------------------------------------------------------------------------
RETRIEVAL_TOP_K=5
RETRIEVAL_SCORE_THRESHOLD=0.25

# -----------------------------------------------------------------------------
# LangGraph Redis checkpointer (question-api session state)
# -----------------------------------------------------------------------------
# Redis 8+ or Redis Stack (RedisJSON + RediSearch).
# Helm installs Redis Stack and maps local defaults to redis://rag-redis-stack:6379.
LANGGRAPH_REDIS_URL=redis://127.0.0.1:6379
# SESSION_CHECKPOINT_TTL_DAYS=5
# SESSION_CHECKPOINT_TTL_REFRESH_ON_READ=true

# -----------------------------------------------------------------------------
# DeepEval retriever benchmark tuning
# -----------------------------------------------------------------------------
DEEPEVAL_JUDGE_PROVIDER=anthropic
DEEPEVAL_TOP_K_GRID=3,5,8
DEEPEVAL_THRESHOLD_GRID=0.4,0.6,0.8
DEEPEVAL_GOLDENS_PATH=evals/src/rag_evals/data/goldens_bills_115hr1625enr.json
DEEPEVAL_VERBOSE_MODE=false
DEEPEVAL_REPORT_FILE_TYPE=markdown

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_LEVEL=DEBUG
LOG_FORMAT=json